{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "钥巢主窗口权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "clipboard-manager:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "shell:default",
    "opener:default",
    "opener:allow-open-url",
    "opener:allow-open-path"
  ]
}
