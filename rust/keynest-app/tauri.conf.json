{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "钥巢",
  "version": "0.1.0",
  "identifier": "com.keynest.app",
  "build": {
    "frontendDist": "../../src/renderer"
  },
  "app": {
    "windows": [
      {
        "title": "钥巢",
        "width": 1360,
        "height": 880,
        "minWidth": 760,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": true,
        "backgroundColor": "#f3f4f9"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "../../build/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      }
    }
  }
}
