# 依赖
node_modules/

# Rust 构建产物（体积巨大，绝不能进仓库）
rust/target/
target/

# 本地打包出来的可运行副本（二进制产物，不进版本库）
release-out/
release-stage/
ext-stage/

# 测试产物
test/e2e-data/
test/e2e-onboard-data/
test/shots/

# 日志
*.log

# ===== 密码与密钥：绝不能进仓库 =====
# 真实的密码库文件
vault.dat
vault.dat.bak
vault.dat.tmp
*.dat.bak
# 单实例锁文件
vault.lock

# 浏览器导出的明文 CSV（最常见的事故源）
passwords*.csv
*密码*.csv
*passwords*.csv
Chrome*.csv
Edge*.csv
Firefox*.csv

# 明文导出
keynest-*.csv
keynest-*.json

# 环境变量与本地配置
.env
.env.*
*.local
.npmrc.local

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 打包产物
dist/
# 注意：`build/icon.png` **不是**产物，是图标源文件。
# 它由 scripts/make-icon.py 生成后要进仓库——`main.rs` 用 include_bytes!
# 把它编进二进制，缺了它全新检出就编译不过（v0.5.0 的发布就是这么失败的）。
rust/keynest-app/gen/

# ===== 单文件绿色版与备份产物（第二阶段补充）=====
# dist-egui 里是直接可双击的 exe，体积大且可重新构建
dist-egui/
*.exe
*.bundle

# 旧版 Electron 时期的截图（已被 docs/shots/ 取代，仅本地留存）
docs/ui/

# 验收脚本的运行产物（每轮不同，不入库）
test/acceptance/.out/
.tmp-verify/
